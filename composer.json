{
    "name": "mahdi-mh/fallback-chain",
    "description": "A lightweight PHP package for building fallback chains with callable handlers and failure callbacks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "fallback",
        "chain",
        "retry",
        "handler",
        "callback",
        "php"
    ],
    "autoload": {
        "psr-4": {
            "MahdiMh\\FallbackChain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MahdiMh\\FallbackChain\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mahdi Mohammadi",
            "email": "lord2350.mm@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.5 || ^10.0 || ^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
